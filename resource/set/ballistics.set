; Profiles for various weapon classes. Defines how the damage to human health is adjusted over distance.
; 1st value is distance (weapon range multiplied by value)(example: weapon range 100m & value 0.5 = 50m)
; 2nd value is damage (weapon damage multiplied by value)(example: weapon damage 50 & value 0.5 = -25 health)
;	{curve "example"
;		{0.75	0.5}		at 75% of weapons max range, it does 50% of defined damage from weapon file

{ballistics
	{curve "bullet"			;// bolt action rifles like mosins and kar98ks
		{0.05	1.00}		;// 6m   250d
		{0.10	1.00}		;// 13m  140d
		{0.33	1.00}		;// 40m  70d
		{0.5	1.00}		;// 65m  46d
		{1.0	1.00}		;// 130m 20d
		{3.0	0.65}
		{20.0	0.5}		
	}

	{curve "bullet_sniper"	;// sniper rifles
		{0.05	1.00}		
		{0.10	1.00}		
		{0.33	1.00}		
		{0.5	1.00}		
		{1.0	1.00}		
		{3.0	0.65}
		{20.0	0.5}	
	}

	{curve "autorifle"		;// automatic, semi-automatic, battle, 
		{0.05	1.00}		
		{0.10	1.00}		
		{0.33	1.00}		
		{0.5	1.00}		
		{1.0	1.00}				
		{3.0	0.65}
		{20.0	0.5}	
	}

	{curve "assaultrifle"	;// assault rifles (stg)
		{0.05	1.00}		;// 6m   250d
		{0.10	1.00}		;// 13m  140d
		{0.33	1.00}		;// 40m  70d
		{0.5	1.00}		;// 65m  46d
		{1.0	1.00}		;// 130m 20d
		{3.0	0.5}
		{20.0	0.3}

	}

	{curve "bullet_mg"		;// machine guns, damage 80
		{0.05	1.00}		
		{0.10	1.00}		
		{0.33	1.00}		
		{0.5	1.00}		
		{1.0	1.00}		
		{3.0	0.75}
		{20.0	0.4}	
	}

	{curve "bullet_hmg"		;// heavy machine guns, damage 160
		{0.05	1.00}		
		{0.10	1.00}		
		{0.33	1.00}		
		{0.5	1.00}		
		{1.0	1.00}		
		{3.0	0.8}
		{20.0	0.5}
	}

	{curve "bullet_smg"		;// sub-machine guns, damage 55
		{0.0	1.00}		
		{0.15	1.00}		
		{0.5	1.00}		
		{1.0	1.00}		
		{3.0	0.5}
		{10.0	0.2}
	}

	{curve "bullet_pistol"	;// pistols
		{0.0	1.00}		
		{0.15	1.00}		
		{0.5	1.00}		
		{1.0	1.00}		
		{3.0	0.4}
		{10.0	0.05}
	}

	{curve "shotgun"
		{0.2	1.00}
		{0.6	1.00}
		{1.0	0.8}
		{3	0.3}
		{10	0.1}
	}

	{curve "gun_autocannon"	;// 20-25mm auto cannons
		{0		1.00}
		{0.1	1.00}
		{1		1.00}
		{3.0	0.5}
		{20.0	0.2}
		
	}

	{curve "gun_std"		;// all other weapons / cannons
		{0		1.0}
		{1		1.0}
		{3		0.5}
		{20		0.2}
	}
}