(include "\set\small_firearms_accuracy.inc")
(include "\set\blast.inc")

(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)

(define "velocity"				;// muzzle velocity in meters per second
	{speed (* 0.75 %mps)}
)
(define "penetration"			;// penetration table. penetration reduced after intended fire range to prevent explotation of Direct control
	{projectileDamageTable {80 %0} {100 0}}
)
(define "standard_slope"    ; a flatter warhead nose that ensures detonation on impact more reliably
	{overmatchSlope
		{0 1}
		{40 99}
		{60 99}
		{90 99}
	}
)
(define "pointed_slope"       ; a pointed warhead nose that deflects off of armour more
	{overmatchSlope
		{0 1}
		{60 99}
		{90 99}
	}
)