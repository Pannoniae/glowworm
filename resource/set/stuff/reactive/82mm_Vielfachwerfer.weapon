;_________________________________________
; German Light Rocket Artillery
;=========================================


{from "pattern reactive"		; "Vielfachwerfer" lightest katyusha rocket
	{filling "ammo 82mm_rs82" 48}
	{fillingVisible "rocket"}
	{fireSound "reactive/rocket_burst/"}
	{calibre 82}

	("rocket_artillery")
	
	{spreading
		{radiusTable
			{0 0}
			{100 10}
			{200 20}
			{375 30}	;// past their max range
			{500 35}
		}
	}
	
	{burst 
		{min 48}
		{noaiming}
	}

	{range 330 330}
	
	("velocity" mps(340))
	("reload time" seconds(200))
	("fire rate" rpm(360))
	
	{gravity 1.5}
}