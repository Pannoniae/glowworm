; German Heavy Rocket Artillery
;=========================================


{from "pattern reactive"		; "300mm_nebelwerfer42"
	{tag "gun"}
	{filling "ammo 300mm_nebelwerfer" 6}
	{fireSound "reactive/nebel_burst/"}
	{calibre 300}

	("rocket_artillery")

	{spreading
		{radiusTable
			{0 0}
			{100 10}
			{200 20}
;			{279.99 40} ;// old max range
			{300 40}    ;// new max range
			{500 45}
		}
	}

	{burst 
		{min 6}
		{noaiming}
	}
	{gravity 1.5}

	{minRange 50}
	{aimRange 300}
	{maxRange 300} ;//4,55km
	("velocity" mps(230))
	("reload time" seconds(240))
	("fire rate" rpm(36)) ;// 10s to fire full salvo
}