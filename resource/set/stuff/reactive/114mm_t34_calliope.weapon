;_________________________________________
; US calliope Rocket Artillery
;=========================================


{from "pattern reactive"		; "M4 calliope"
	{filling "ammo 114mm_m8" 60}
	{fireSound "reactive/katy_burst/"}
	{calibre 114}
	("rocket_artillery")

	{spreading
		{radiusTable
			{0 0}
			{100 10}
			{200 20}
			{269.99 35} ;// max range, 3.7km
			{270 40}
			{300 50}
			{500 200}
		}
	}

	{burst
		{min 30}
		{noaiming}
	}
	{gravity 1.5}

	{minRange 50}
	{range 300 300} ;//3.7km
	("velocity" mps(270))
	("reload time" seconds(300))
	("fire rate" rpm(360)) ;// 6 rockets every second in "ripple fire". 5s to fire full salvo
}