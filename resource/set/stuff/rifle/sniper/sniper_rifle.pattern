{from "pattern rifle"
    {tag " -shoot_walking -shoot_walking_ai shoot_walking_manual auto_eject rifle_shell"}


	{states
		{reload		"reload"}
		{unload		"unload"}
		{fire		"fire"	}
		{aim 		"aim"	}
		{can_aim	"can-aim-bolt"}
	}

	{cursor "ironsights/mg"}
	{foresight "foresight12"}

	{curve "bullet_sniper"}
	{range 250 250}

	{ZeroingAccuracy 0.9 0.8 0.7 0.6 0.5}

	{aimingTolerance 2.5}
	{RelaxationTime 3}           ;time it takes soldiers to "relax" from aim adjustments and get their full accuracy
	("reload time" seconds(6))
	("fire rate" rpm(48))

	("human health" damage(125))
	("penetration" args 6.5 3.5)
	{FiringTimeout 3 0.5}
	{FiringTimeoutDistanceFactor
		{0.2 1}		;50m, 3s
		{0.4 2}		;100m, 6s
		{0.6 4}		;150m, 12s
		{0.8 5}		;200m, 15s
		{1.0 8}		;250m, 24s
	}

	("accuracy_rifle_sniper")

	{thirdpersonparams inherit "human default"}

	("recoil_sniper_bolt")
	("sway_sniper")
	("ap_7_62_slope_multiplier")
}