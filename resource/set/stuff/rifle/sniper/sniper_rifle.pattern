{from "pattern rifle"
	{tag "sniper -shoot_walking -shoot_walking_ai shoot_walking_manual bolt_action rifle_shell"}
	
;		{special
; 		{mode aim}
;		{PrepareTime 1}         ; time it takes for the circle to go around and get the shot
;		{PrepareCursor "aimed_shot"}
;		{PrepareCursorScene "aimed_shot_scene"}
;		{accuracy 10} ; permit the increase in accuracy to simulate zeroing and calculating
;		{damage 1}    ; 1 for no damage boosting, remove vanilla cringe
;		}

	{states
		{reload		"reload"}
		{unload		"unload"}
		{fire		"fire"	}
		{aim 		"aim"	}
		{can_aim	"can-aim-bolt"}
	}

	{cursor "ironsights/mg"}
	{foresight "foresight12"}

	{curve "bullet_sniper"}
	{range 250 250}

	{ZeroingAccuracy 0.9 0.8 0.7 0.6 0.5}

	{aimingTolerance 2.5}
	{RelaxationTime 2}
	("reload time" seconds(6))
	("fire rate" rpm(24))

	("human health" damage(125))
	("penetration" args 6.5 3.5)
	{FiringTimeout 12 0.5}
	{FiringTimeoutDistanceFactor
		{0.2 0.1}	;50m, 1.2s
		{0.4 0.4}	;100m, 5s
		{0.6 0.6}	;150m, 8s
		{0.8 1.0}	;200m, 12s
		{1.0 1.5}	;250m, 18s
	}

	("accuracy_rifle_sniper")

	{thirdpersonparams inherit "human default"}

	("recoil_sniper_bolt")
	("sway_sniper")
	("ap_7_62_slope_multiplier")
}