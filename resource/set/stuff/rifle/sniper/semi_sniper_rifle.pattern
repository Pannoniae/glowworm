{from "pattern rifle"
	{tag "sniper -shoot_walking -shoot_walking_ai shoot_walking_manual auto_eject rifle_shell"}

	{special
		{mode aim}
		{PrepareTime 0.8}        ; time it takes for the circle to go around and get the shot
		{PrepareCursor "aimed_shot"}
		{PrepareCursorScene "aimed_shot_scene"}
		{accuracy 6}  ; permit the increase in accuracy to simulate zeroing and calculating
		{damage 1}    ; 1 for no damage boosting, remove vanilla cringe
	}

	{cursor "ironsights/mg"}

	{curve "bullet_sniper"}
	{range 200 200}

	{spreading
		{BurstAccuracy 100 90 80 70 60 50}
	}

	{aimingTolerance 2.5}
	{RelaxationTime 1.5}           ;time it takes soldiers to "relax" from aim adjustments and get their full accuracy
	("fire rate" rpm(175))

	("human health" damage(125))
	("penetration" args 6.5 3.5)
	{FiringTimeout 2 0.5}
	{FiringTimeoutDistanceFactor
		{0.05 0.1}	;10m, 0.2s
		{0.1 0.25}	;20m, 0.5s
		{0.4 2.0}	;80m, 4s
		{0.6 3.0}	;120m, 6.0s
		{1.0 6.0}	;200m, 12.0s
	}

	("accuracy_rifle_auto_sniper")

	{thirdpersonparams inherit "human default"}

	("recoil_sniper_semi")
	("sway_sniper")
	("ap_7_62_slope_multiplier")
}