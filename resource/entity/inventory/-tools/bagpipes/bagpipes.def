{actor
	(include "/properties/stuff_small.ext")
	{extension "bagpipes.mdl"}
	{props "bagpipes"}
	{extender "stuff"
		{item "bagpipes"}
	}
	{nogroupmesh 4}
	
	{volume "body"
			{able {select} {contact_ground} {touch} {contact} {bullet} {blast}}
		{thickness 5}
				{component "body"}

	}
	{volume "select"
			{able {select} {contact_ground} {touch} {contact} {bullet} {blast}}
		{thickness 5}
				{component "body"}
	}
}
