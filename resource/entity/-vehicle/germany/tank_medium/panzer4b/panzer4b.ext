;// Defines
	("tank_medium_tier1")
	("tracks" repair(30) thickness(20))
	("gun" repair(30) thickness(25))

	("fuel" args "fuel")
	("transmission" args "transmission")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")

	("shield" args "shieldl1" 4)
	("shield" args "shieldl2" 4)
	("shield" args "shieldr1" 4)
	("shield" args "shieldr2" 4)
	("shield_track" args "shield1" 20)

;// Components
	{volume "body1"		;// Hull
		{thickness 20
			{front 30}
			{left 14.5}
			{right 20} 	;// Top nose and bottom nose
			{rear 10}
			{top 11}
			{bottom 8}
		}
	}
	{volume "body2"		;// superstructure
		{thickness 20
			{front 30}
			{left 14.5}
			{rear 10}
			{top 11}
			{bottom 8}
		}
	}
	{volume "turret1" {thickness 14.5 {front 30} {top 10} {bottom 8}}} 	;// Entire Turret
	{volume "turret2" {thickness 14.5 {top 10} {bottom 8}}} 			;// Hatch + rear part of turret, RD (rounded)
	{volume "turret3" {thickness 30} {able {holed}}} 					;// Frontal part of the turret, RD
	{volume "mantlet"
		{thickness 30}
		{tags "turret"}
		{component "turret"}
	}
	{volume "engine1" 	;// Bottom part of the engine, superstructure
		{thickness 14.5
			{front 10}
			{right 10} 	;// Bottom nose, rear
			{top 10}
			{bottom 8}
		}
	}
	{volume "engine2" 	;// Above superstructure
		{thickness 10
			{rear 14.5}
			{bottom 8}
		}
	}

;// Non-Components
	{volume "armor1" {thickness 5}} 	;// Muffler
	{volume "cupola" {thickness 30}}
	{component "shield1" {tags "cut_part"}}
	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}
	{component "shieldr1" {tags "cut_part"}}
