{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "mortar" "tank" "halftrack" "wheeled" "with_gun" "multi_board" "explosion_throw_crew" "vision_lev02" "tractor" "tractor_heavy" "detect_artillery_small" "open_death_fx_low" "artillery_minimap_light"}
	{able "emit_passangers_on_enemy"}
	{extension "sdkfz251d_2xgrw42.mdl"}
	(include "sdkfz251d_1.ext")
	{patherId "sdkfz251"}
	{targetclass "armoredcar"}
	{targetSelector "cannon_howitzer"}


	{boarder
		{anm "driver"
			{forward {begin "halftrack_driver_board"} {end "halftrack_driver_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "gunner"
			{forward {begin "halftrack_pass_l_01_board"} {end "cannon_small_commander"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "charger"
			{forward {begin "halftrack_pass_l_04_board"} {end "seat_m7_com"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "charger2"
			{forward {begin "halftrack_pass_l_04_board"} {end "halftrack_pass_l_04_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "commander"
			{forward {begin "halftrack_commander_board"} {end "halftrack_commander_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
	}

	("crew" place(driver)		bone(driver)	door(emit1)		animation(driver)		visor(driver)	off({sensor}))
	("crew" place(gunner)		bone(gunner)	door(emit2)		animation(gunner)		visor(visor1)		off({sensor}))
	("crew" place(charger)		bone(charger)	door(emit2)		animation(charger2)		visor(none)		off())
	("crew" place(commander)	bone(commander)	door(emit1)		animation(commander)		visor(none)		off({sensor}))

	{sensor
		{visor "human"
			{vision "none"}
		}
		{visor "around"
			{vision "none"}
		}
		{visor "main"
			{vision "cannon_mortar"}
			{bone "visor"}
		}
	}

	{extender "inventory"
		{Box
			{item "mortarger_120 he" 28}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "weapon 2x120mm_sgrw42" filling "mortarger_120 he" 2}
			{RestoreIKAfterAim}
			{Barrels 2}
			{gunner "gunner"}
			{charger "gunner"}
			{foresight "foresight"}
			{basic}
			("abm_dymamic_mortar"
				zeroing(3.0)	; // time it takes to aim until the reticle shrinks. Bigger values, more control.
				dispersion(1)   ; // time it takes to distort the reticle when you move the gun (how abrupt it loses zeroing). Bigger values, more control.
			)
		}
	}

	{mass 7810}
	{Chassis "wheel"
		("tank_trace_ex" fx("tracks_sm2") step(0.2) len(0.49) boneleft("FXtraceL3") boneright("FXtraceR3"))
		("car_trace" fx("tracewheel03a") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(53) ;----------------------------------Max speed.
			speedatmaxturn(14) ;-------------------------Max speed at max turn.
			reverse(9) ;---------------------------------Max speed in Reverse.
			weight(7.81) ;--------------------------------Weight in Tonnes.
			power(100) ;---------------------------------Horse Power.
			fuel(160) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(150) ;---------------------------------Range in Kilometers.
		)
	}
	{bone "turret"
		{limits -115 115}
		{speed2 10}
	}
	{bone "foresight"
		{limits -25 40}
		{speed2 10}
	}
}