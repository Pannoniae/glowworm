{actor
	(include "/properties/ammo_box.ext")
	(include "/properties/resupply.inc")
	{extension "inf_crate.mdl"}
	{props "vision_lev00_can" "ammo_crate" "no_recrew_logic"}

	("supply_ammo" supply(250))

	{extender "inventory"
		{Box
		{item "mk2 grenade" 30}
		{item "m7 grenade" 10}
		{item "anm8_smoke grenade" 10}
		{item "satchel_charge_usa" 1}
		}
	}

	{mass 100}
}
