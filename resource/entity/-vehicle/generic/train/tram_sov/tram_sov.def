	{boarder
		{anm "driver"
			{forward {begin	"board_steam_locomotive"} {end "pose_tram_driver"} {base "doorleft"}}
			{reverse {end "board_steam_locomotive" -1} {base "doorleft" -1}}
		}
		{anm "driver1"
			{forward {begin	"board_steam_locomotive"} {end "pose_tram_driver"} {base "doorright"}}
			{reverse {end "board_steam_locomotive" -1} {base "doorright" -1}}
		}
	}

	("crew_human" place(driver) bone(driver) door(emit1) animation(driver))
	("crew_human" place(driver) bone(driver) door(emit2) animation(driver1))
	
    {mass 15000}

