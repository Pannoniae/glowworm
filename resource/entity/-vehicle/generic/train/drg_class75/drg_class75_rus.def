{game_entity
	(include "/properties/railway.ext")
	(include "/properties/car_crew.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(2))
	{Extension "drg_class75_rus.mdl"}
	{props "steam_locomotive" "windowed" "train_part" "vision_lev05"}

	("train_durability" body(500) engine(250) turret(300) mantlet(225) gun(225))

	{mass 76000}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed	70	}
			{StartTime	8	}
			{BrakeTime	6	}
		}
	}
	{extender "inventory"
		{box
			{Size 9 12}
			{Weight 15000}
			{item "can" 1}
			{item "repair_kit" 5}
		}
	}
	{placer
		{place "driver" {group "crew"} {linkbone "driver"} {turnoff {sensor} {shadow}}}
	}

	{boarder
		{anm "driver_left"
			{forward	{begin "board_steam_locomotive"} {end "Steam_locomotive_driver"} {base "doorleft"}}
			{reverse	{end "board_steam_locomotive" -1} {base "doorleft" -1}}
		}
		{anm "driver_right"
			{forward	{begin "board_steam_locomotive"} {end "Steam_locomotive_driver"} {base "doorright"}}
			{reverse	{end "board_steam_locomotive" -1} {base "doorright" -1}}
		}
		{door "emit"}
		{door "emit1"}
		{link "emit" "driver" {anm "driver_left"} {forward putoff} {reverse puton}}
		{link "emit1" "driver" {anm "driver_right"} {forward putoff} {reverse puton}}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelright2")
	("wheel" args "wheelright3")
	("wheel" args "wheelright4")
	("wheel" args "wheelright5")
	("wheel" args "wheelleft1")
	("wheel" args "wheelleft2")
	("wheel" args "wheelleft3")
	("wheel" args "wheelleft4")
	("wheel" args "wheelleft5")
	("glass" args "window1")
	("glass" args "window2")
	("glass" args "window3")
	("glass" args "window4")
	("glass" args "window5")
	("glass" args "window6")

	{volume "body1"
		{thickness 20}
	}
	{volume "body2"
		{thickness 5}
		{able {holed}}
	}
	{volume "body3"
		{thickness 20}
	}
	{volume "body4"
		{thickness 20}
	}
	{volume "body5"
		{thickness 20}
	}
	{volume "body6"
		{thickness 20}
	}
	{volume "body7"
		{thickness 20}
	}
	{volume "engine1"
		{thickness 10}
	}
	{volume "engine2"
		{thickness 10}
	}
	{volume "engine3"
		{thickness 10}
	}
	{volume "engine4"
		{thickness 10}
	}
	{volume "engine5"
		{thickness 10}
	}
	{volume "hatch"
		{thickness 10}
		{tags "engine"}
		{component "engine"}
	}
	{volume "wheelleft1"
		{thickness 30}
	}
	{volume "wheelleft2"
		{thickness 30}
	}
	{volume "wheelleft3"
		{thickness 30}
	}
	{volume "wheelright1"
		{thickness 30}
	}
	{volume "wheelright2"
		{thickness 30}
	}
	{volume "wheelright3"
		{thickness 30}
	}
	{texmod "rus"}
}
