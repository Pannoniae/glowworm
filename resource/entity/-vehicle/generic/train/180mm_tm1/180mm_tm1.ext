		}
	}

	(define "crew_human_visible_anm"
		{placer
			{place "%place"
				{group "crew"}
				{visor "%visor"}
				{linkbone "%linkbone"}
				{turnoff %off}
				;{openForCrush}
			}
		}
		{boarder
			{anm "1_gunner"
				{forward {begin "board_kv"} {end "pose_m5_gunlayer"} {base "doorleft1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorleft1" -1}}
			}
			{anm "2_gunner"
				{forward {begin "board_tank_right"} {end "pose_m5_gunlayer"} {base "doorright2"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright2" -1}}
			}
			{anm "3_gunner"
				{forward {begin "board_tank_right"} {end "pose_m5_gunlayer"} {base "doorright1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright1" -1}}
			}

			{anm "1_charger"
				{forward {begin "board_kv"} {end "seat_tm1_charger"} {base "doorleft1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorleft1" -1}}
			}
			{anm "2_charger"
				{forward {begin "board_tank_right"} {end "seat_tm1_charger"} {base "doorright2"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright2" -1}}
			}
			{anm "3_charger"
				{forward {begin "board_tank_right"} {end "seat_tm1_charger"} {base "doorright1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright1" -1}}
			}

			{anm "1_commander"
				{forward {begin "board_kv"} {end "pose_watch_binocular"} {base "doorleft1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorleft1" -1}}
			}
			{anm "2_commander"
				{forward {begin "board_tank_right"} {end "pose_watch_binocular"} {base "doorright2"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright2" -1}}
			}
			{anm "3_commander"
				{forward {begin "board_tank_right"} {end "pose_watch_binocular"} {base "doorright1"}}
				{reverse {end "emit_tank_1_hold"} {base "doorright1" -1}}
			}

			{door "%door"}
			{door "%door2"}
			{door "%door3"}
			{link "%door" "%place" {anm "1_%pose"} {forward putoff} {reverse puton}}
			{link "%door2" "%place" {anm "2_%pose"} {forward putoff} {reverse puton}}
			{link "%door3" "%place" {anm "3_%pose"} {forward putoff} {reverse puton}}
		}
	)
	("crew_human_visible_anm" place(driver) linkbone() door(emit1) door2(emit2) door3(emit3) visor(driver) pose(gunner) off({sensor}))
	("crew_human_visible_anm" place(gunner) linkbone(gunner) door(emit1) door2(emit2) door3(emit3) pose(gunner) visor(main) off({sensor}))
	("crew_human_visible_anm" place(charger) linkbone(charger) door(emit1) door2(emit2) door3(emit3) pose(charger) visor(none) off({sensor}))
	("crew_human_visible_anm" place(charger2) linkbone(charger2) door(emit1) door2(emit2) door3(emit3) pose(charger) visor(none) off())
	("crew_human_visible_anm" place(commander) linkbone(commander) door(emit1) door2(emit2) door3(emit3) pose(commander) visor(none) off())