{game_entity
	(include "/properties/railway.ext")
	
	{mass 10000}
	{props "platform" "train_part" "no_minimap_view"}

	{Placer
		{place "vehicle"
			{Linkbone "attach_vehicle"}
			{handlebone "basis"}
			{attach}
		}
	}

	{Extension "wagon1.mdl"}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{volume "body1"
		{thickness 10}
	}
	{volume "body2"
		{thickness 30}
		{able {visible 0}}
	}
	{volume "body3"
		{thickness 5}
		{material "wood"}
	}
	{volume "body4"
		{thickness 5}
		{material "wood"}
	}
	{volume "body5"
		{thickness 5}
		{material "wood"}
	}
	{volume "detail1"
		{thickness 5}
		{material "wood"}
		{tags "body"}
	}
	{volume "detail2"
		{thickness 5}
		{material "wood"}
		{tags "body"}
	}
	{volume "wheelleft1"
		{thickness 30}
	}
	{volume "wheelleft2"
		{thickness 30}
	}
	{volume "wheelright1"
		{thickness 30}
	}
	{volume "wheelright2"
		{thickness 30}
	}
	{component "body"}
}
