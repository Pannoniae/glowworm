{game_entity
	(include "/properties/car.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	{props "multi_board" "truck" "vision_lev02" "tractor" "tractor_heavy" "Captor"}
	{extension "studebaker.mdl"}
	{able "emit_on_attack"}
	{collider "truck"}
	{patherId "gazaaa"}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft3")

	("glass" args "glassr")
	("glass" args "glassl")
	("glass" args "glass")
	("fuel" args "fuel1")
	("fuel" args "fuel2")

	("car_thickness" body(2.5) engine(1.5))

	{volume "body6" {able {holed}}}
	{volume "fuel1" {able {NoWoundDecal 0}}}
	{volume "fuel2" {able {NoWoundDecal 0}}}
	{volume "transmission" {able {NoWoundDecal 0}}}

	("bodyback" repair(30))
	("shield_cover")

	{volume "bodyback1" {material "wood"} {tags "wood"} {able {holed}}}
	{volume "bodyback2" {material "wood"} {tags "wood"}}
	{volume "shield_cover" {able {holed}}}
	
	{extender "shield" {on}}
	
	("crew_2_human")

	{placer {place "commander" {group "crew"}}}

	("board_animation"
		place(driver)
		board_begin(board_opel_driver)
		board_end(seat_driver_car)
		base(doorleft)
	)
	("board_animation"
		place(commander)
		board_begin(board_big-highcar)
		board_end(seat_passenger)
		base(doorright)
	)

	("passenger_12_human")
	{boarder
		{anm "passenger"
			{forward {begin "board_body"} {end "seat_passenger"} {base "board"}}
			{reverse {end "emit_body" 1} {base "board"}}
		}
	}

	{extender "inventory"
		{box
			
		}
	}

	

	{mass 8000}
	{Chassis
		("car_trace" fx("tracewheel01") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel01d") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(60) ;----------------------------------Max speed.
			speedatmaxturn(17) ;-------------------------Max speed at max turn.
			reverse(24) ;--------------------------------Max speed in Reverse.
			weight(8.0) ;--------------------------------Weight in Tonnes.
			power(73) ;----------------------------------Horse Power.
			fuel(80) ;-----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(145) ;---------------------------------Range in Kilometers.
		)
		{DisableMoveWhileFiring}
	}
}