{fx
	{#+ lightview
		{type point}
		{animator
			{scale 1
				{linear
					{min 0.25}
					{max 2}
				}
			}
			{visibility 1
				{linear
					{min 1}
					{max 0}
				}
			}
			{highlight 0xffe1ba82}
			{timer
				{duration 0.03 0.01}
			}
		}
		{intensity 45}
		{radius 120}        ;; increased light radius (was 60)
		{radiusfalloff 0}
		{effectonground}
		{offset 0 0 15}
	}

	;; --- MAIN FLASH ---
	{##+ spriteview muz3
		{#+ sprite "$/flash/flashss3"
			{light 1
				{linear {min 0.5} {max 0}}
			}
			{timer {duration 0.035} {mode play}}
			{scale 3.3}      ;; was 0.2 → now larger, still sharp/brief
			{preturn 0 360}
			{highlight 0xffe1ba82}
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- SIDE STREAKS (XY/XZ) ---
	{#+ spriteview "muz1 xy"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 2.9 {linear {min 0.16} {max 0.18}}}   ;; wider streaks
			{scaley 1.36 {linear {min 0.123} {max 0.123}}}   ;; taller streaks
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 1 {linear {min 0.1} {max 0.1}}}
		}
		{orientation normalXY}
		{autovisible}
	}

	{#+ spriteview "muz1 xz"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 2.9 {linear {min 0.16} {max 0.18}}}   ;; wider streaks
			{scaley 1.36 {linear {min 0.123} {max 0.123}}}   ;; taller streaks
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 1 {linear {min 0.1} {max 0.1}}}
		}
		{orientation normalXZ}
		{autovisible}
	}

	;; --- SIDE BURSTS ---
	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 2.1 {linear {min 0.15} {max 0.17}}} ;; thicker
			{scaley 1.1 {linear {min 0.123} {max 0.123}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXZ}
		{autovisible}
	}

	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 2.1 {linear {min 0.15} {max 0.17}}} ;; thicker
			{scaley 1.1 {linear {min 0.123} {max 0.123}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXY}
		{autovisible}
	}

	;; --- REAR FLASH ---
	{##+ spriteview "muzzle rear"
		{sprite "$/flash/muzzle-back"
			{scale 2.1 {linear {min 0.12} {max 0.12}}}  ;; was 0.015 → more visible from behind
			{timer {mode play} {duration 0.035}}
			{preturn 0 360}
			{visibility 1 {linear {min 1} {max 0}}}
			{highlight 0xffe1ba82}
		}
		{orientation normalYZ}
		{autovisible}
	}
	{#+ spriteview "muz1 xy    "
		{sprite "$/flash/muzzle-back"
			{light 1
				{## linear
					{min 0.5}
					{max 0}
				}
			}
			{##+ scalex 0.76
				{linear
					{min 0.38}
					{max 0.38}
				}
			}
			{##+ scaley 0.67
				{linear
					{min 0.055}
					{max 0.055}
				}
			}
			{timer
				{duration 0.035}
				{mode play }
			}
			{highlight 0xffe1ba82}
			{scale 1
				{linear
					{min 0.038}
					{max 0.038}
				}
			}
			{preturn 0 360}
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- HALOS / BLOOM ---
	{##+ spriteview halo1
		{sprite "$/flash/halo02"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.35} {max 0.35}}}
			{scale 1.5}     ;; was 0.3 → stronger bloom
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 1 1 1}
		{nightonly}
	}

	{##+ spriteview halo2
		{sprite "$/flash/flash_g03"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.75} {max 0.75}}}
			{scale 0.9}   ;; was 0.1
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 0 0 0}
	}
}