{fx
	{#+ lightview
		{type point}
		{animator
			{scale 1
				{linear
					{min 0.25}
					{max 2}
				}
			}
			{visibility 1
				{linear
					{min 1}
					{max 0}
				}
			}
			{highlight 0xffe1ba82}
			{timer
				{duration 0.03 0.01}
			}
		}
		{intensity 32}
		{radius 105}        ;; increased light radius (was 60)
		{radiusfalloff 0}
		{effectonground}
		{offset 0 0 15}
	}

	;; --- MAIN FLASH ---
	{##+ spriteview muz3
		{#+ sprite "$/flash/flashss3"
			{light 1
				{linear {min 0.5} {max 0}}
			}
			{timer {duration 0.035} {mode play}}
			{scale 0.3}      ;; was 0.2 → now larger, still sharp/brief	
			{preturn 90 90}		
			{highlight 0xffe1ba82}	
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- SIDE STREAKS (XY/XZ) ---
	{#+ spriteview "muz1 xy"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 0.2 {linear {min 0.15} {max 0.153}}}   ;; wider streaks
			{scaley 0.15 {linear {min 0.1} {max 0.112}}}   ;; taller streaks
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 0.27 {linear {min 0.082} {max 0.082}}}
		}
		{orientation normalXY}
		{autovisible}
	}

	{#+ spriteview "muz1 xz"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 0.1 {linear {min 0.15} {max 0.153}}}
			{scaley 0.16 {linear {min 0.07} {max 0.07}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 0.27 {linear {min 0.082} {max 0.082}}}
		}
		{orientation normalXZ}
		{autovisible}
	}

	;; --- SIDE BURSTS ---
	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 0.1 {linear {min 0.1} {max 0.1}}} ;; thicker
			{scaley 0.15 {linear {min 0.07} {max 0.07}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXZ} 		
		{autovisible}
	}

	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 0.18 {linear {min 0.1} {max 0.152}}} ;; thicker
			{scaley 0.16 {linear {min 0.1} {max 0.1113}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXY}
		{autovisible}
	}

	;; --- REAR FLASH ---
	{##+ spriteview "muzzle rear"
		{sprite "$/flash/muzzle-back"
			{scale 0.25 {linear {min 0.06} {max 0.06}}}  ;; was 0.015 → more visible from behind
			{timer {mode play} {duration 0.035}}
			{visibility 1 {linear {min 1} {max 0}}}				
			{highlight 0xffe1ba82}
			{preturn 0 180}
		}
		{orientation normalYZ}
		{autovisible}
	}
	{#+ spriteview "muz1 xy    "
		{sprite "$/flash/muzzle-back"
			{light 1
				{## linear
					{min 0.5}
					{max 0}
				}
			}
			{##+ scalex 0.74
				{linear
					{min 0.24}
					{max 0.24}
				}
			}
			{##+ scaley 0.64
				{linear
					{min 0.047}
					{max 0.047}
				}
			}
			{timer
				{duration 0.035}
				{mode play }
			}
			{highlight 0xffe1ba82}
			{scale 1
				{linear
					{min 0.027}
					{max 0.027}
				}
			}
			{preturn 0 360}
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- HALOS / BLOOM --
	{##+ spriteview halo1
		{sprite "$/flash/halo02"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.35} {max 0.35}}}
			{scale 0.6}     ;; was 0.3 → stronger bloom
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 1 1 1}
		{nightonly}
	}

	{##+ spriteview halo2
		{sprite "$/flash/flash_g03"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.75} {max 0.75}}}
			{scale 0.45}   ;; was 0.1
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 0 0 0}
	}
}