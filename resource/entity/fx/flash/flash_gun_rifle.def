{fx
	{#+ lightview
		{type point}
		{animator
			{scale 1
				{linear
					{min 0.25}
					{max 2}
				}
			}
			{visibility 1
				{linear
					{min 1}
					{max 0}
				}
			}
			{highlight 0xffe1ba82}
			{timer
				{duration 0.03 0.01}
			}
		}
		{intensity 38}
		{radius 120}        ;; increased light radius (was 60)
		{radiusfalloff 0}
		{effectonground}
		{offset 0 0 15}
	}

	;; --- MAIN FLASH ---
	{##+ spriteview muz3
		{#+ sprite "$/flash/flashss3"
			{light 1
				{linear {min 0.5} {max 0}}
			}
			{timer {duration 0.035} {mode play}}
			{scale 1.0}      ;; was 0.2 → now larger, still sharp/brief
			{preturn 0 360}
			{highlight 0xffe1ba82}
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- SIDE STREAKS (XY/XZ) ---
	{#+ spriteview "muz1 xy"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 1.3 {linear {min 0.141} {max 0.145}}}   ;; wider streaks
			{scaley 0.5 {linear {min  0.035} {max 0.08}}}   ;; taller streaks
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 1 {linear {min 0.1} {max 0.1}}}
		}
		{orientation normalXY}
		{autovisible}
	}

	{#+ spriteview "muz1 xz"
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 1.3 {linear {min 0.141} {max 0.145}}}   ;; wider streaks
			{scaley 0.5 {linear {min  0.11} {max 0.11}}}   ;; taller streaks
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
			{scale 1 {linear {min 0.1} {max 0.1}}}
		}
		{orientation normalXZ}
		{autovisible}
	}

	;; --- SIDE BURSTS ---
	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 1.0 {linear {min 0.13} {max 0.15}}} ;; thicker
			{scaley 0.3 {linear {min 0.1} {max 0.1}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXZ}
		{autovisible}
	}

	{##+ spriteview muz2
		{sprite "$/flash/muzzle-side2"
			{light 1}
			{scalex 1.0 {linear {min 0.13} {max 0.15}}} ;; thicker
			{scaley 0.3 {linear {min 0.08} {max 0.08}}}
			{timer {duration 0.035} {mode play}}
			{highlight 0xffe1ba82}
		}
		{orientation normalXY}
		{autovisible}
	}

	;; --- REAR FLASH ---
	{##+ spriteview "muzzle rear"
		{sprite "$/flash/muzzle-back"
			{scale 1.1 {linear {min 0.1} {max 0.1}}}  ;; was 0.015 → more visible from behind
			{timer {mode play} {duration 0.035}}
			{preturn 0 360}
			{visibility 1 {linear {min 1} {max 0}}}
			{## turn -115}
			{highlight 0xffe1ba82}
		}
		{orientation normalYZ}
		{autovisible}
	}
	{#+ spriteview "muz1 xy    "
		{sprite "$/flash/muzzle-back"
			{light 1
				{## linear
					{min 0.5}
					{max 0}
				}
			}
			{##+ scalex 0.78
				{linear
					{min 0.31}
					{max 0.31}
				}
			}
			{##+ scaley 0.67
				{linear
					{min 0.057}
					{max 0.057}
				}
			}
			{timer
				{duration 0.035}
				{mode play }
			}
			{highlight 0xffe1ba82}
			{scale 1
				{linear
					{min 0.035}
					{max 0.035}
				}
			}
			{preturn 0 360}
		}
		{orientation normalYZ}
		{autovisible}
	}

	;; --- HALOS / BLOOM ---
	{##+ spriteview halo1
		{sprite "$/flash/halo02"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.35} {max 0.35}}}
			{scale 1.2}     ;; was 0.3 → stronger bloom
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 1 1 1}
		{nightonly}
	}

	{##+ spriteview halo2
		{sprite "$/flash/flash_g03"
			{timer {mode play} {duration 0.35}}
			{light 1 {linear {min 0.35} {max 0.75}}}
			{scale 0.7}   ;; was 0.1
		}
		{notifyowner}
		{halo}
		{autovisible}
		{offset 0 0 0}
	}
}